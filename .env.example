# Copy this file to .env, next to HashHarvest.exe, and fill in your key.
# .env is git-ignored. A VT_API_KEY set in the environment wins over this file.

# VirusTotal API key (https://www.virustotal.com/gui/my-apikey). Only the
# VirusTotal lookup needs it; leave it empty to type the key in the app.
VT_API_KEY=
